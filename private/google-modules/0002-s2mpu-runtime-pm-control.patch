From 0000000000000000000000000000000000000007 Mon Sep 17 00:00:00 2001
From: husky-port CI <ci@husky-port.local>
Date: Fri, 7 Nov 2026 09:30:00 +0000
Subject: [PATCH] phy-exynos-usbdrd-eusb: hold S2MPU awake, wait for s2mpu link

Follow-up to the runtime-PM workaround, fixing both observed failure
modes:

1. Early boot hang/panic: dwc3 can call manual_control(true) before the
   pkvm_s2mpu driver has probed, so phy_drd->s2mpu is still NULL and the
   call silently does nothing -> HSI0 SysMMU fault as soon as the USB
   gadget does DMA.  Wait briefly for the link to appear.
2. USB drop ~5 min into UT boot: the rtpm variant suspended S2MPU on
   manual_control(false), which can power-gate HSI0 translations while
   USB DMA is still in flight (UT re-enumerates the gadget during boot).
   Keep the usage count held forever; the 'off' path becomes a no-op.

---
--- a/soc/gs/drivers/phy/samsung/phy-exynos-usbdrd-eusb.c
+++ b/soc/gs/drivers/phy/samsung/phy-exynos-usbdrd-eusb.c
@@ -17,6 +17,8 @@
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/delay.h>
 #include <linux/mfd/syscon.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
@@ -1859,7 +1860,6 @@
 int exynos_usbdrd_s2mpu_manual_control(bool on)
 {
 	struct exynos_usbdrd_phy *phy_drd;
-	int (*__s2mpu_notify)(struct device *dev, bool on);
 
 	pr_debug("%s s2mpu = %d\n", __func__, on);
 
@@ -1870,14 +1870,30 @@
 		return -ENODEV;
 	}
 
-	/* Paired with cmpxchg_release in exynos_usbdrd_set_s2mpu_pm_ops. */
-	__s2mpu_notify = smp_load_acquire(&s2mpu_notify);
-	if (!phy_drd->s2mpu || !__s2mpu_notify)
+	/*
+	 * The s2mpu link is established asynchronously when the pkvm_s2mpu
+	 * driver probes; dwc3 can call us before that.  Wait briefly for it.
+	 */
+	{
+		int retries = 200;
+
+		while (!phy_drd->s2mpu && retries--)
+			usleep_range(10000, 20000);
+	}
+
+	if (!phy_drd->s2mpu)
 		return 0;
 
-	__s2mpu_notify(phy_drd->s2mpu, on);
-
-	return 0;
+	/*
+	 * Bypass the cross-module function pointer: on zuma builds the
+	 * registered callback can be corrupted and trips CFI.  Use runtime PM
+	 * to wake S2MPU, but keep the usage count held forever: suspending
+	 * drops HSI0 translations while USB DMA can still be in flight.
+	 */
+	if (on)
+		return pm_runtime_resume_and_get(phy_drd->s2mpu);
+
+	return 0;
 }
 EXPORT_SYMBOL_GPL(exynos_usbdrd_s2mpu_manual_control);
 
-- 
