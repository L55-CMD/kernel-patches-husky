From 391238a25022446e5e6d5ba08d29d63be2cef807 Mon Sep 17 00:00:00 2001
From: Steffen Deusch <steffen@deusch.me>
Date: Tue, 3 Nov 2026 09:33:15 +0000
Subject: [PATCH] google/zuma+shusky: halium kernel support

- zuma: build hci_vhci.ko (bluebinder)
- shusky: add halium.config defconfig fragment (AppArmor, waydroid,
  binder devices, squashfs)
---
 google/shusky/BUILD.bazel   |  2 +-
 google/shusky/halium.config | 26 ++++++++++++++++++++++++++
 google/zuma/constants.bzl   |  1 +
 3 files changed, 28 insertions(+), 1 deletion(-)
 create mode 100644 google/shusky/halium.config

diff --git a/google/shusky/BUILD.bazel b/google/shusky/BUILD.bazel
index db0b069..f013bcc 100644
--- a/google/shusky/BUILD.bazel
+++ b/google/shusky/BUILD.bazel
@@ -12,7 +12,7 @@ device_build(
     build_system_dlkm = True,
     build_vendor_dlkm = True,
     build_vendor_kernel_boot = True,
-    defconfig_fragments = ["shusky_defconfig"],
+    defconfig_fragments = ["shusky_defconfig", "halium.config"],
     dtb_outs = ZUMA_DTBS,
     dtbo_additional_outs = ZUMA_DPM_DTBOS,
     dtbo_outs = SHUSKY_DTBOS,
diff --git a/google/shusky/halium.config b/google/shusky/halium.config
new file mode 100644
index 0000000..31ce547
--- /dev/null
+++ b/google/shusky/halium.config
@@ -0,0 +1,26 @@
+CONFIG_VT=y
+CONFIG_NULL_TTY=y
+CONFIG_DEVTMPFS=y
+# bluebinder - keep as modules to match GKI expectations
+CONFIG_BT_HCIVHCI=m
+# Do not enforce kernel modules signature
+# CONFIG_MODULE_SIG_FORCE is not set
+# CONFIG_MODULE_SIG_PROTECT is not set
+
+# AppArmor
+CONFIG_SECURITY_APPARMOR=y
+CONFIG_DEFAULT_SECURITY_APPARMOR=y
+CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf"
+
+# Waydroid
+CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_FILE_DIRECT=y
+CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
+# Snap
+CONFIG_SQUASHFS_LZ4=y
+CONFIG_SQUASHFS_LZO=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_SQUASHFS_ZSTD=y
+CONFIG_CFI_PERMISSIVE=y
diff --git a/google/zuma/constants.bzl b/google/zuma/constants.bzl
index 4ec3161..50ef789 100644
--- a/google/zuma/constants.bzl
+++ b/google/zuma/constants.bzl
@@ -20,6 +20,7 @@ ZUMA_DPM_DTBOS = [
 
 ZUMA_MODULE_OUTS = [
     # keep sorted
+    "drivers/bluetooth/hci_vhci.ko",
     "drivers/gpu/drm/display/drm_display_helper.ko",
     "drivers/i2c/i2c-dev.ko",
     "drivers/misc/eeprom/at24.ko",
-- 
2.54.0.windows.1

