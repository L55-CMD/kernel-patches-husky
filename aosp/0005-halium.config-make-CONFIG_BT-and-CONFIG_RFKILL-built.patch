From 186858d387d6f842788a6c82134b9cbd63d7e98b Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 23 Jan 2026 17:20:11 +0200
Subject: halium.config: make CONFIG_BT and CONFIG_RFKILL built-in

---
 arch/arm64/configs/halium.config | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/configs/halium.config b/arch/arm64/configs/halium.config
index 426757416ee3..e48a71c9b52b 100644
--- a/arch/arm64/configs/halium.config
+++ b/arch/arm64/configs/halium.config
@@ -7,7 +7,11 @@ CONFIG_DEVTMPFS=y
 # CONFIG_LTO_CLANG_FULL=y will fail without a LOT of RAM
 CONFIG_LTO_CLANG_THIN=y
 # bluebinder
+CONFIG_BT=y
+CONFIG_BT_RFCOMM=y
+CONFIG_BT_HIDP=y
 CONFIG_BT_HCIVHCI=y
+CONFIG_RFKILL=y
 # Do not enforce kernel modules signature
 # CONFIG_MODULE_SIG_FORCE is not set
 # CONFIG_MODULE_SIG_PROTECT is not set
-- 
