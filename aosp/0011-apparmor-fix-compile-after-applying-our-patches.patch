From ff2c71c01d8f956af9bdbfca5c9649f1a1b980b7 Mon Sep 17 00:00:00 2001
From: Jami Kettunen <jami.kettunen@protonmail.com>
Date: Fri, 13 Feb 2026 15:23:37 +0200
Subject: apparmor: fix compile after applying our patches

---
 security/apparmor/af_unix.c       | 4 ++--
 security/apparmor/net.c           | 2 +-
 security/apparmor/policy_unpack.c | 8 ++++----
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/security/apparmor/af_unix.c b/security/apparmor/af_unix.c
index 54b3796f63d0..76821155b23a 100644
--- a/security/apparmor/af_unix.c
+++ b/security/apparmor/af_unix.c
@@ -580,10 +580,10 @@ static void unix_state_double_lock(struct sock *sk1, struct sock *sk2)
 	}
 	if (sk1 < sk2) {
 		unix_state_lock(sk1);
-		unix_state_lock_nested(sk2);
+		unix_state_lock_nested(sk2, U_LOCK_SECOND);
 	} else {
 		unix_state_lock(sk2);
-		unix_state_lock_nested(sk1);
+		unix_state_lock_nested(sk1, U_LOCK_SECOND);
 	}
 }
 
diff --git a/security/apparmor/net.c b/security/apparmor/net.c
index 955faa12ddf1..76ecfba09336 100644
--- a/security/apparmor/net.c
+++ b/security/apparmor/net.c
@@ -95,7 +95,7 @@ static void audit_unix_addr(struct audit_buffer *ab, const char *str,
 }
 
 static void audit_unix_sk_addr(struct audit_buffer *ab, const char *str,
-			       struct sock *sk)
+			       const struct sock *sk)
 {
 	struct unix_sock *u = unix_sk(sk);
 	if (u && u->addr)
diff --git a/security/apparmor/policy_unpack.c b/security/apparmor/policy_unpack.c
index d1e72248393e..64eadc69a0fc 100644
--- a/security/apparmor/policy_unpack.c
+++ b/security/apparmor/policy_unpack.c
@@ -285,8 +285,8 @@ static bool unpack_u8(struct aa_ext *e, u8 *data, const char *name)
 
 static bool unpack_u16(struct aa_ext *e, u16 *data, const char *name)
 {
-	if (unpack_nameX(e, AA_U16, name)) {
-		if (!inbounds(e, sizeof(u16)))
+	if (aa_unpack_nameX(e, AA_U16, name)) {
+		if (!aa_inbounds(e, sizeof(u16)))
 			return false;
 		if (data)
 			*data = le16_to_cpu(get_unaligned((__le16 *) e->pos));
@@ -820,7 +820,7 @@ static struct aa_profile *unpack_profile(struct aa_ext *e, char **ns_name)
 		goto fail;
 	}
 
-	size = unpack_array(e, "net_allowed_af");
+	size = aa_unpack_array(e, "net_allowed_af");
 	if (size || VERSION_LT(e->version, v8)) {
 		profile->net_compat = kzalloc(sizeof(struct aa_net_compat), GFP_KERNEL);
 		if (!profile->net_compat) {
@@ -847,7 +847,7 @@ static struct aa_profile *unpack_profile(struct aa_ext *e, char **ns_name)
 			if (!unpack_u16(e, &profile->net_compat->quiet[i], NULL))
 				goto fail;
 		}
-		if (size && !unpack_nameX(e, AA_ARRAYEND, NULL))
+		if (size && !aa_unpack_nameX(e, AA_ARRAYEND, NULL))
 			goto fail;
 		if (VERSION_LT(e->version, v7)) {
 			/* pre v7 policy always allowed these */
