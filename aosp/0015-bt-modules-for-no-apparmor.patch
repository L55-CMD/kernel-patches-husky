From 8689acf60ebdd0635cc9a397d14c4c0312655f9e Mon Sep 17 00:00:00 2001
From: Luke <luke@localhost>
Date: Tue, 3 Nov 2026 20:50:43 +0000
Subject: [PATCH] halium.config: BT as modules (GKI trim compat)

---
 arch/arm64/configs/halium.config | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/configs/halium.config b/arch/arm64/configs/halium.config
index 414180d..4311b48 100644
--- a/arch/arm64/configs/halium.config
+++ b/arch/arm64/configs/halium.config
@@ -6,12 +6,11 @@ CONFIG_NULL_TTY=y
 CONFIG_DEVTMPFS=y
 # CONFIG_LTO_CLANG_FULL=y will fail without a LOT of RAM
 CONFIG_LTO_CLANG_THIN=y
-# bluebinder
-CONFIG_BT=y
-CONFIG_BT_RFCOMM=y
-CONFIG_BT_HIDP=y
-CONFIG_BT_HCIVHCI=y
-CONFIG_RFKILL=y
+# bluebinder - keep as modules to match GKI module_outs list
+CONFIG_BT=m
+CONFIG_BT_RFCOMM=m
+CONFIG_BT_HIDP=m
+CONFIG_RFKILL=m
 # Do not enforce kernel modules signature
 # CONFIG_MODULE_SIG_FORCE is not set
 # CONFIG_MODULE_SIG_PROTECT is not set
-- 
2.54.0.windows.1

