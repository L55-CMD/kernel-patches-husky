From e612afc4691549a5f601c850392fa8ab3e910507 Mon Sep 17 00:00:00 2001
From: Steffen Deusch <steffen@deusch.me>
Date: Fri, 17 Apr 2026 15:30:50 +0000
Subject: build_utils: copy etc into flattened DLKM image

---
 build_utils.sh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/build_utils.sh b/build_utils.sh
index d3d2065..23fe1e4 100644
--- a/build_utils.sh
+++ b/build_utils.sh
@@ -348,6 +348,11 @@ function build_flattened_dlkm_image() {
   # consistent with the non-flattened output.
   cp ${staging_dir}/flatten/lib/modules/modules.load ${dist_dir}/${image_type}_dlkm.flatten.modules.load
 
+  # Copy etc/ files (e.g. init.insmod.*.cfg) into the flattened image
+  if [[ -d "${staging_dir}/etc" ]]; then
+    cp -r ${staging_dir}/etc ${staging_dir}/flatten/etc
+  fi
+
   build_image "${staging_dir}/flatten" "${props_file}" \
   "${dist_dir}/${image_name}" /dev/null
 
